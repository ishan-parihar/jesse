[Unit]
Description=Jesse Autonomous Trading Agent
Documentation=https://github.com/ishan-parihar/jesse
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=PROJECT_DIR_PLACEHOLDER

EnvironmentFile=PROJECT_DIR_PLACEHOLDER/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=PROJECT_DIR_PLACEHOLDER/src
Environment=MT5_MCP_URL=http://127.0.0.1:8010

ExecStartPre=PROJECT_DIR_PLACEHOLDER/scripts/jesse-preflight.sh
ExecStart=PROJECT_DIR_PLACEHOLDER/.venv/bin/python -m apps.jesse_agent.main

Restart=always
RestartSec=10
RuntimeMaxSec=86400
SuccessExitStatus=143

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jesse-agent

ReadWritePaths=/home/%USER%/.mt5-mcp PROJECT_DIR_PLACEHOLDER
PrivateTmp=true

MemoryMax=2G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
